# Dedicated asymmetric identity key. Gateway receives PUBLIC key only.
MASTERKEY_GATEWAY_PUBLIC_KEY=
MASTERKEY_GATEWAY_ISSUER=provance-api
MASTERKEY_GATEWAY_URL=http://127.0.0.1:4010
MASTERKEY_GATEWAY_HOST=127.0.0.1
MASTERKEY_GATEWAY_PORT=4010
# Restricted login with ONLY provance_masterkey_gateway role capabilities.
# Optional for catalog-only development; mandatory in production.
MASTERKEY_GATEWAY_DATABASE_URL=
# For Supabase, download the CA from Database Settings. Verification stays enabled.
MASTERKEY_GATEWAY_DATABASE_CA_FILE=
# No CDP, Coinbase email, MongoDB, Anthropic, Sponge or wallet keys needed for this service-only entry point.
# Upstream Next app retains its original dependencies; npm run gateway:* never starts it.
# Dedicated operating wallet only. Never a user trading key or upstream wallet master key.
MASTERKEY_FEE_PRIVATE_KEY=
MASTERKEY_FEE_PAYER_ADDRESS=
BASE_RPC_URL=
